# 应用服务
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Elasticsearch：本机 Elasticsearch 9.4.4 提供 HTTPS 与 CA 校验。
# 多个节点使用英文逗号分隔。
ELASTICSEARCH_HOSTS=https://localhost:9200
# 用户名和密码必须同时填写；本机默认用户通常为 elastic。
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# 系统 CA 目录对运行用户不可读时，将证书复制到此本地运行时路径。
ELASTICSEARCH_CA_CERTS=data/certs/http_ca.crt
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_INDEX_NAME=contracts-v1
# 仅用于入库验收；验收可以删除并用正式 mapping 重建该索引。
ELASTICSEARCH_INGESTION_EXPERIMENT_INDEX_NAME=contracts-ingestion-experiment-v1
ELASTICSEARCH_VECTOR_DIMENSIONS=4096
ELASTICSEARCH_NUMBER_OF_SHARDS=1
ELASTICSEARCH_NUMBER_OF_REPLICAS=0

# 本地 vLLM 多模态模型：Core→Attribute、Clause、Abstract 共享并发配额。
VLLM_MLLM_PROVIDER=vllm
VLLM_MLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MLLM_API_KEY=
VLLM_MLLM_MODEL=qwen3.6-35b-a3b-fp8
VLLM_MLLM_ENDPOINT=chat_completions
VLLM_MLLM_TIMEOUT_SECONDS=300
VLLM_MLLM_MAX_CONCURRENT_REQUESTS=20
VLLM_MLLM_CONTEXT_WINDOW_TOKENS=65536
# 严格 JSON 提取必须显式关闭 Qwen3.6 的默认思考模式。
VLLM_MLLM_ENABLE_THINKING=false
VLLM_MLLM_TEMPERATURE=0.7
VLLM_MLLM_TOP_P=0.8
VLLM_MLLM_TOP_K=20
VLLM_MLLM_PRESENCE_PENALTY=1.5
VLLM_MLLM_REPETITION_PENALTY=1.0
VLLM_MLLM_SEED=3407
VLLM_MLLM_MAX_COMPLETION_TOKENS=8192
# 普通 A4 页使用 2× 渲染；超大画布需按视觉 token 预算缩放。
VLLM_MLLM_MAX_RENDER_SCALE=2.0
VLLM_MLLM_VISUAL_TOKEN_PATCH_SIZE=32
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_PAGE=4096
# 留空时根据上下文窗口、生成预算和预留空间动态计算。
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_REQUEST=
VLLM_MLLM_RESERVED_PROMPT_TOKENS=4096
# 为多轮工具调用历史、消息包装和视觉估算误差保留。
VLLM_MLLM_RESERVED_RUNTIME_TOKENS=10240

# 本地 vLLM 嵌入模型。
VLLM_EMBEDDING_PROVIDER=vllm
VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
VLLM_EMBEDDING_API_KEY=
VLLM_EMBEDDING_MODEL=qwen3-vl-embedding-8b
VLLM_EMBEDDING_ENDPOINT=embeddings
VLLM_EMBEDDING_TIMEOUT_SECONDS=60
VLLM_EMBEDDING_BATCH_SIZE=32
VLLM_EMBEDDING_MAX_CONCURRENT_REQUESTS=10
VLLM_EMBEDDING_DIMENSIONS=4096
VLLM_EMBEDDING_NORMALIZE=true

# 本地 vLLM 重排模型。
VLLM_RERANKER_PROVIDER=vllm
VLLM_RERANKER_BASE_URL=http://127.0.0.1:8002/v1
VLLM_RERANKER_API_KEY=
VLLM_RERANKER_MODEL=qwen3-vl-reranker-8b
VLLM_RERANKER_ENDPOINT=rerank
VLLM_RERANKER_TIMEOUT_SECONDS=60
VLLM_RERANKER_CANDIDATE_LIMIT=20
VLLM_RERANKER_TOP_N=5
