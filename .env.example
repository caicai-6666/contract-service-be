# 应用服务
APP_ENV=development
COMMUNICATION_DATABASE_FILE=data/communication/communication.db
# 原生扩展由scripts/install_lindera.py安装；无后缀路径自动匹配本机平台。
SQLITE_LINDERA_EXTENSION_PATH=data/extensions/lindera/liblindera_sqlite
# 进程统一中文Jieba配置；修改分词规则后已有FTS索引需要重建。
LINDERA_CONFIG_PATH=config/lindera-jieba.yml
# 合同分类的权威定义与正反例目录；启动时全量校验并读入内存。
CONTRACT_CATEGORY_DEFINITION_DIR=data/definition/contract-category
# Core 字段定义总目录；启动时全量校验并读入内存。
FIELD_DEFINITION_DIR=data/definition/field
# Retrieval Question 的提问指南总目录；启动时全量校验并读入内存。
RETRIEVAL_VIEW_GUIDE_DIR=data/definition/retrieval-view
# 审核用户名称与密钥文件；启动时全量校验并读入不可变内存对象。
REVIEWER_USER_FILE=data/user/users.yaml
# 正式合同文件管理元数据的 SQLite 文件；相对路径按项目根目录解析。
CONTRACT_METADATA_DATABASE_FILE=data/abstract/contracts.db
# 免登码在当前 API 进程内存中的存活时间，单位为秒。
AUTH_LOGIN_CODE_TTL_SECONDS=3600
# 单份合同允许模型提出的问题数量上限；实际问题可以少于该值。
RETRIEVAL_VIEW_MAX_QUESTIONS=8
# 上传任务及其 PDF、中间状态和草稿只保存在当前 API 进程内存中。
CONTRACT_EXTRACTION_RUN_TTL_SECONDS=3600
# 查重有超过阈值的候选且无重复时，等待用户确认的期限；无候选直接推进。
CONTRACT_DEDUPLICATION_REVIEW_TTL_SECONDS=600
CONTRACT_EXTRACTION_CLEANUP_INTERVAL_SECONDS=30
# 支持浏览器携带 Last-Event-ID 断线续传的每任务事件数量。
CONTRACT_EXTRACTION_EVENT_BUFFER_SIZE=256
CONTRACT_EXTRACTION_SSE_HEARTBEAT_SECONDS=15
# 包含首次执行；每个失败业务阶段默认最多尝试三次。
CONTRACT_EXTRACTION_MAX_STAGE_ATTEMPTS=3

# Elasticsearch 应用连接；容器版本、端口及 JVM 参数由独立 deploy 项目管理。
# 多个节点使用英文逗号分隔。
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
# 应用启动时探测该正式索引，不存在则创建，并增量补齐新增 Core mapping。
ELASTICSEARCH_INDEX_NAME=contracts-v1
# 仅用于入库验收；验收可以删除并用正式 mapping 重建该索引。
ELASTICSEARCH_INGESTION_EXPERIMENT_INDEX_NAME=contracts-ingestion-experiment-v1
# 合同中文全文字段的索引与查询分析器；使用 smartcn 时目标节点必须已安装对应插件。
ELASTICSEARCH_TEXT_ANALYZER=smartcn
ELASTICSEARCH_VECTOR_DIMENSIONS=4096
ELASTICSEARCH_NUMBER_OF_SHARDS=1
ELASTICSEARCH_NUMBER_OF_REPLICAS=0

# 本地 vLLM 多模态模型：Core、Clause、Retrieval View 共享并发配额。
VLLM_MLLM_PROVIDER=vllm
VLLM_MLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MLLM_API_KEY=
VLLM_MLLM_MODEL=qwen38-flash-next
# data/tool-tag 下的模板文件名；启动时读取，修改后重启生效。
VLLM_MLLM_TOOL_TAG_FILE=qwen3.8-flash-next-nvfp4.txt
VLLM_MLLM_ENDPOINT=chat_completions
VLLM_MLLM_TIMEOUT_SECONDS=300
# 单 worker 全局 MLLM 在途请求额度，所有合同、节点和客户端共享
VLLM_MLLM_MAX_CONCURRENT_REQUESTS=20
# vLLM 0.21+：同页首次发送完整数据，后续请求只发送 UUID 引用。
VLLM_MLLM_USE_MEDIA_REFERENCES=true
VLLM_MLLM_CONTEXT_WINDOW_TOKENS=262144
# 全局默认关闭思考；节点可显式开启，JSON Schema 输出约束与思考开关分别配置。
VLLM_MLLM_ENABLE_THINKING=True
# 本地 MLLM 默认推理强度（合同提取和业务门禁使用下方独立配置）；仅开启思考时传入。统一 low/medium/xhigh；DS4.1 自动映射为 50/75/100。
# GLM5.3: 同一三档映射为 low/high/max；官方模板不支持关闭思考。
VLLM_MLLM_REASONING_EFFORT=xhigh
# 合同提取（含识别、质量检查与查重）独立推理强度：low/medium/xhigh。
VLLM_MLLM_EXTRACTION_REASONING_EFFORT=low
# 会话业务门禁独立推理强度：low/medium/xhigh；不影响 Agent Core 与合同提取。
VLLM_MLLM_BUSINESS_GATE_REASONING_EFFORT=xhigh
VLLM_MLLM_TEMPERATURE=0.7
VLLM_MLLM_TOP_P=0.8
VLLM_MLLM_TOP_K=20
VLLM_MLLM_PRESENCE_PENALTY=1.5
VLLM_MLLM_REPETITION_PENALTY=1.0
VLLM_MLLM_SEED=3407
VLLM_MLLM_MAX_COMPLETION_TOKENS=8192
# 普通 A4 页使用 2× 渲染；超大画布需按视觉 token 预算缩放。
VLLM_MLLM_MAX_RENDER_SCALE=2.0
VLLM_MLLM_VISUAL_TOKEN_PATCH_SIZE=32
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_PAGE=4096
# 留空时根据上下文窗口、生成预算和预留空间动态计算。
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_REQUEST=
VLLM_MLLM_RESERVED_PROMPT_TOKENS=4096
# 为多轮工具调用历史、消息包装和视觉估算误差保留。
VLLM_MLLM_RESERVED_RUNTIME_TOKENS=10240

# PDF 查重：两份候选 PDF 适合一次性送入 MLLM 的双重限制。
PDF_DEDUP_SINGLE_SHOT_VISUAL_TOKEN_RATIO=0.75
PDF_DEDUP_SINGLE_SHOT_MAX_TOTAL_PAGES=20
# ES kNN 使用的原始 cosine 下限；低于该值的合同不进入 MLLM 判重。
PDF_DEDUP_MINIMUM_RECALL_COSINE_SIMILARITY=0.60

# 本地 vLLM 嵌入模型。
VLLM_EMBEDDING_PROVIDER=vllm
VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
VLLM_EMBEDDING_API_KEY=
VLLM_EMBEDDING_MODEL=qwen3-vl-embedding-8b
VLLM_EMBEDDING_ENDPOINT=embeddings
VLLM_EMBEDDING_TIMEOUT_SECONDS=60
VLLM_EMBEDDING_BATCH_SIZE=32
# 单 worker 全局 Embedding 在途请求额度，文本与页面向量化共用
VLLM_EMBEDDING_MAX_CONCURRENT_REQUESTS=10
VLLM_EMBEDDING_DIMENSIONS=4096
VLLM_EMBEDDING_NORMALIZE=true

# 主助手原生思考 FIFO：完整条目按轮数及 token 双重限制驱逐，0 禁用回注
VLLM_MLLM_REASONING_WINDOW_ROUNDS=3
VLLM_MLLM_REASONING_WINDOW_MAX_TOKENS=16384

# 主助手临时页面保留轮数：正整数；落盘/恢复始终使用折叠占位
VLLM_MLLM_PAGE_DISPLAY_ROUNDS=5

# 共享合同文件池容量，单位为文件数，必须为正整数。
COMMUNICATION_CONTRACT_FILE_CACHE_MAX_FILES=32

# 每个会话附件文件池容量，单位为文件数，必须为正整数。
COMMUNICATION_SESSION_FILE_CACHE_MAX_FILES=8

# 外部专家 DeepSeek：仅预留配置，尚未接入调用；API Key 可留空。
# 超时、并发和输出预算为本项目初始值；不复用本地 vLLM 参数。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=300
DEEPSEEK_MAX_CONCURRENT_REQUESTS=3
DEEPSEEK_MAX_COMPLETION_TOKENS=8192

# DeepSeek 思考强度：none 关闭；low、high、max 开启，默认 high。
DEEPSEEK_REASONING_EFFORT=high

# Neo4j 应用连接；无认证，不配置用户名和密码。容器配置由 deploy 管理。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
# 建立连接的超时秒数，不是查询执行超时。
NEO4J_CONNECTION_TIMEOUT_SECONDS=30

# 工具驻留与分页：均为正整数；容量按每个驻留会话计算。修改后重启生效。
# 每个会话记忆查询结果池容量
COMMUNICATION_MEMORY_QUERY_CACHE_MAX_QUERIES=10
# 记忆查询每页任务数
COMMUNICATION_MEMORY_QUERY_PAGE_SIZE=3
# 每个会话外部专家会话池容量
COMMUNICATION_EXPERT_SESSION_CACHE_MAX_SESSIONS=10
# 每个会话合同关联快照池容量
COMMUNICATION_CONTRACT_RELATIONS_CACHE_MAX_CONTRACTS=10
# 合同关联每页关系数
COMMUNICATION_CONTRACT_RELATIONS_PAGE_SIZE=5

# 每个驻留会话的合同注意事项池容量和每页条数，正整数；重启生效。
COMMUNICATION_CONTRACT_NOTES_CACHE_MAX_CONTRACTS=10
COMMUNICATION_CONTRACT_NOTES_PAGE_SIZE=5

# 合同检索结果驻留与分页（每会话）
COMMUNICATION_CONTRACT_SEARCH_CACHE_MAX_QUERIES=10
COMMUNICATION_CONTRACT_SEARCH_PAGE_SIZE=5

# 问题检索召回数量与原始余弦下限（留空不设门槛）
COMMUNICATION_CONTRACT_QUESTION_SEARCH_TOP_K=10
COMMUNICATION_CONTRACT_QUESTION_SEARCH_MINIMUM_SIMILARITY=

# 用户备注混合检索最多返回合同数（1–50）
COMMUNICATION_CONTRACT_NOTE_SEARCH_TOP_K=10

# 合同摘要混合检索最多返回合同数（1–50）
COMMUNICATION_CONTRACT_SUMMARY_SEARCH_TOP_K=10

# 合同名称 BM25 检索最多返回合同数（1–50）
COMMUNICATION_CONTRACT_NAME_SEARCH_TOP_K=10

# 关系检索：候选边数、每会话结果集容量、每页边数
COMMUNICATION_RELATION_SEARCH_TOP_K=10
COMMUNICATION_RELATION_SEARCH_CACHE_MAX_QUERIES=10
COMMUNICATION_RELATION_SEARCH_PAGE_SIZE=3

# 合同候选查询子Agent轮数上限
COMMUNICATION_CONTRACT_RETRIEVAL_MAX_ROUNDS=16

# 最终合同候选：独立会话缓存容量与页大小
COMMUNICATION_CONTRACT_RETRIEVAL_CACHE_MAX_QUERIES=10
COMMUNICATION_CONTRACT_RETRIEVAL_PAGE_SIZE=5

# 条款 BM25 合同候选数量上限
COMMUNICATION_CONTRACT_CLAUSE_SEARCH_TOP_K=10

# 跨查询排名融合；本轮权重为1减历史权重
COMMUNICATION_CONTRACT_RETRIEVAL_RRF_K=60
COMMUNICATION_CONTRACT_RETRIEVAL_HISTORY_WEIGHT=0.5

# 网页搜索：会话结果池、分页及服务额度
COMMUNICATION_WEB_SEARCH_CACHE_MAX_QUERIES=10
COMMUNICATION_WEB_SEARCH_PAGE_SIZE=5
COMMUNICATION_WEB_SEARCH_MAX_RESULTS=20
COMMUNICATION_WEB_SEARCH_TIMEOUT_SECONDS=10
COMMUNICATION_WEB_SEARCH_MAX_CONCURRENT_REQUESTS=2

# 网页精炼结果驻留与分页
COMMUNICATION_WEB_PAGE_CACHE_MAX_ENTRIES=10
COMMUNICATION_WEB_PAGE_CHARS=3000

# 仅 development：本人任务的独立链路调试，包含模型输入输出。
COMMUNICATION_TRACE_ENABLED=false

# 中途反馈提醒间隔（秒）；0关闭，未有效反馈则每轮重新提醒。
VLLM_MLLM_PROGRESS_REMINDER_INTERVAL_SECONDS=60
