# 应用服务
APP_ENV=development
# 合同分类的权威定义与正反例目录；启动时全量校验并读入内存。
CONTRACT_CATEGORY_DEFINITION_DIR=data/definition/contract-category
# Core 字段定义总目录；启动时全量校验并读入内存。
FIELD_DEFINITION_DIR=data/definition/field
# Retrieval Question 的提问指南总目录；启动时全量校验并读入内存。
RETRIEVAL_VIEW_GUIDE_DIR=data/definition/retrieval-view
# 审核用户名称与密钥文件；启动时全量校验并读入不可变内存对象。
REVIEWER_USER_FILE=data/user/users.yaml
# 正式合同文件管理元数据的 SQLite 文件；相对路径按项目根目录解析。
CONTRACT_METADATA_DATABASE_FILE=data/abstract/contracts.db
# 免登码在当前 API 进程内存中的存活时间，单位为秒。
AUTH_LOGIN_CODE_TTL_SECONDS=3600
# 单份合同允许模型提出的问题数量上限；实际问题可以少于该值。
RETRIEVAL_VIEW_MAX_QUESTIONS=8
# 上传任务及其 PDF、中间状态和草稿只保存在当前 API 进程内存中。
CONTRACT_EXTRACTION_RUN_TTL_SECONDS=3600
# 查重结果返回后等待继续请求的最长时间；不能超过 600 秒。
CONTRACT_DEDUPLICATION_REVIEW_TTL_SECONDS=600
CONTRACT_EXTRACTION_CLEANUP_INTERVAL_SECONDS=30
# 支持浏览器携带 Last-Event-ID 断线续传的每任务事件数量。
CONTRACT_EXTRACTION_EVENT_BUFFER_SIZE=256
CONTRACT_EXTRACTION_SSE_HEARTBEAT_SECONDS=15
# 包含首次执行；每个失败业务阶段默认最多尝试三次。
CONTRACT_EXTRACTION_MAX_STAGE_ATTEMPTS=3

# Elasticsearch Docker 开发实例；Compose 参数也从本文件读取。
ELASTICSEARCH_VERSION=9.4.5
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
# 多个节点使用英文逗号分隔。
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
# 应用启动时探测该正式索引，不存在则创建，并增量补齐新增 Core mapping。
ELASTICSEARCH_INDEX_NAME=contracts-v1
# 仅用于入库验收；验收可以删除并用正式 mapping 重建该索引。
ELASTICSEARCH_INGESTION_EXPERIMENT_INDEX_NAME=contracts-ingestion-experiment-v1
# 合同中文全文字段的索引与查询分析器；使用 smartcn 时目标节点必须已安装对应插件。
ELASTICSEARCH_TEXT_ANALYZER=smartcn
ELASTICSEARCH_VECTOR_DIMENSIONS=4096
ELASTICSEARCH_NUMBER_OF_SHARDS=1
ELASTICSEARCH_NUMBER_OF_REPLICAS=0

# 本地 vLLM 多模态模型：Core、Clause、Retrieval View 共享并发配额。
VLLM_MLLM_PROVIDER=vllm
VLLM_MLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MLLM_API_KEY=
VLLM_MLLM_MODEL=qwen3.6-35b-a3b-fp8
VLLM_MLLM_ENDPOINT=chat_completions
VLLM_MLLM_TIMEOUT_SECONDS=300
VLLM_MLLM_MAX_CONCURRENT_REQUESTS=20
# vLLM 0.21+：同页首次发送完整数据，后续请求只发送 UUID 引用。
VLLM_MLLM_USE_MEDIA_REFERENCES=true
VLLM_MLLM_CONTEXT_WINDOW_TOKENS=262144
# 严格 JSON 提取必须显式关闭 Qwen3.6 的默认思考模式。
VLLM_MLLM_ENABLE_THINKING=false
VLLM_MLLM_TEMPERATURE=0.7
VLLM_MLLM_TOP_P=0.8
VLLM_MLLM_TOP_K=20
VLLM_MLLM_PRESENCE_PENALTY=1.5
VLLM_MLLM_REPETITION_PENALTY=1.0
VLLM_MLLM_SEED=3407
VLLM_MLLM_MAX_COMPLETION_TOKENS=8192
# 普通 A4 页使用 2× 渲染；超大画布需按视觉 token 预算缩放。
VLLM_MLLM_MAX_RENDER_SCALE=2.0
VLLM_MLLM_VISUAL_TOKEN_PATCH_SIZE=32
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_PAGE=4096
# 留空时根据上下文窗口、生成预算和预留空间动态计算。
VLLM_MLLM_MAX_VISUAL_TOKENS_PER_REQUEST=
VLLM_MLLM_RESERVED_PROMPT_TOKENS=4096
# 为多轮工具调用历史、消息包装和视觉估算误差保留。
VLLM_MLLM_RESERVED_RUNTIME_TOKENS=10240

# PDF 查重：两份候选 PDF 适合一次性送入 MLLM 的双重限制。
PDF_DEDUP_SINGLE_SHOT_VISUAL_TOKEN_RATIO=0.75
PDF_DEDUP_SINGLE_SHOT_MAX_TOTAL_PAGES=20
# ES kNN 使用的原始 cosine 下限；低于该值的合同不进入 MLLM 判重。
PDF_DEDUP_MINIMUM_RECALL_COSINE_SIMILARITY=0.60

# 本地 vLLM 嵌入模型。
VLLM_EMBEDDING_PROVIDER=vllm
VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
VLLM_EMBEDDING_API_KEY=
VLLM_EMBEDDING_MODEL=qwen3-vl-embedding-8b
VLLM_EMBEDDING_ENDPOINT=embeddings
VLLM_EMBEDDING_TIMEOUT_SECONDS=60
VLLM_EMBEDDING_BATCH_SIZE=32
VLLM_EMBEDDING_MAX_CONCURRENT_REQUESTS=10
VLLM_EMBEDDING_DIMENSIONS=4096
VLLM_EMBEDDING_NORMALIZE=true
