.env
.venv/
__pycache__/
*.py[cod]

# JetBrains IDE 配置仅在本地保留。
.idea/
*.iml

# 实验目录（方案、脚本及运行产物）仅在本地保留。
/experiment/

# 输出产物仅在本地保留。
/output/

# 临时文件仅在本地保留。
/tmp/

# 测试代码与产物不纳入 Git。
/tests/

# 运行数据不纳入 Git；Core 字段定义作为启动配置进入版本控制。
/data/**
!/data/input/
!/data/input/.gitkeep
!/data/contract/
!/data/contract/.gitkeep
!/data/abstract/
/data/abstract/*
!/data/abstract/.gitkeep
!/data/template/
!/data/template/qwen3.8-tools-placement.jinja
!/data/tool-tag/
!/data/tool-tag/qwen3.8-flash-next-nvfp4.txt
!/data/definition/
!/data/definition/field/
!/data/definition/field/core/
!/data/definition/field/core/*.yaml
!/data/definition/contract-category/
!/data/definition/contract-category/**
!/data/definition/retrieval-view/
!/data/definition/retrieval-view/**
!/data/user/
!/data/user/users.yaml

!/data/template/deepseek-v4.1-flash.jinja
!/data/tool-tag/deepseek-v4.1-flash.txt
!/data/template/glm-5.3-flash.jinja
!/data/tool-tag/glm-5.3-flash.txt
