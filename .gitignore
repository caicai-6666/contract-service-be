# 仅允许部署必需内容、正式文档和必要目录占位；新增交付资源须显式放行。
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/Dockerfile
!/requirements.txt
!/README.md
!/AGENTS.md

# 应用当前只依赖 Python 源码，不放行目录中可能产生的其他文件。
!/app/
/app/**
!/app/**/
!/app/**/*.py

!/config/
/config/**
!/config/lindera-jieba.yml
!/config/lindera-Cargo.lock

!/description/
/description/**
!/description/**/
!/description/**/*.md

# data 默认属于运行数据，只有权威配置、模型模板及目录占位允许入库。
# 不放行整个 data，避免合同、会话、原生动态库及备份进入源码仓库。
!/data/
/data/**

# 启动时读取的业务定义；允许各层目录及 YAML，其他内容仍忽略。
!/data/definition/
!/data/definition/**/
!/data/definition/**/*.yaml
!/data/definition/**/*.yml

# 新增模型沿用同一规则，不再逐个登记文件名。
!/data/template/
!/data/template/*.jinja
!/data/tool-tag/
!/data/tool-tag/*.txt

# 目录占位仅用于展示布局；实际目录和数据库由程序按需创建。
!/data/contract/
!/data/contract/.gitkeep
!/data/abstract/
!/data/abstract/.gitkeep
!/data/ingestion-review/
!/data/ingestion-review/.gitkeep
!/data/ingestion-review/files/
!/data/ingestion-review/files/.gitkeep
!/data/deletion-review/
!/data/deletion-review/.gitkeep

# 本地辅助脚本不纳入 Git；Dockerfile 独立完成原生扩展构建。
/scripts/

# 通用私有文件与缓存规则最后执行，避免被上面的资源白名单重新放行。
# 本机环境与凭据不入库；环境变量模板属于部署契约，必须保留。
.env
.env.*
!/.env.example

# Python 虚拟环境、编译缓存及开发检查产物。
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/
/build/
/dist/
*.egg-info/

# 操作系统、编辑器临时文件与执行日志。
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
*.log

# JetBrains IDE 配置仅在本地保留。
.idea/
*.iml

# 实验目录（方案、脚本及运行产物）仅在本地保留。
/experiment/

# 输出产物仅在本地保留。
/output/

# 临时文件仅在本地保留。
/tmp/

# 测试代码与产物不纳入 Git。
/tests/
