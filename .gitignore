.env
.venv/
__pycache__/
*.py[cod]

# 实验方案和运行器进入版本控制；运行产物只在本地保留。
/experiment/**/output/

# 测试代码与产物不纳入 Git。
/tests/

# 运行数据不纳入 Git；Core 字段定义作为启动配置进入版本控制。
/data/**
!/data/input/
!/data/input/.gitkeep
!/data/contract/
!/data/contract/.gitkeep
!/data/abstract/
/data/abstract/*
!/data/abstract/.gitkeep
!/data/template/
!/data/template/qwen3.6-tools-placement.jinja
!/data/definition/
!/data/definition/field/
!/data/definition/field/core/
!/data/definition/field/core/*.yaml
!/data/definition/contract-category/
!/data/definition/contract-category/**
!/data/definition/retrieval-view/
!/data/definition/retrieval-view/**
!/data/user/
!/data/user/users.yaml
